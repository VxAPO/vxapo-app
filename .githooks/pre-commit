#!/bin/sh
# 提交前门禁：格式 + 注释纪律。任一未过则拒绝提交。
#
# 本 hook 不随 clone 传播，新克隆的机器先执行一次：
#     git config core.hooksPath .githooks
#
# 只检查，不自动改写。自动格式化会把未预期的改动混进提交，掩盖真实内容。

set -e

# ── 注释纪律 ──
if command -v node >/dev/null 2>&1 && [ -f scripts/check-comments.mjs ]; then
    if ! node scripts/check-comments.mjs . >/dev/null 2>&1; then
        echo "" >&2
        echo "✗ 注释写作纪律未通过，提交被拒绝。" >&2
        echo "" >&2
        echo "  逐条查看：  node scripts/check-comments.mjs ." >&2
        echo "  写作规范：  AGENTS.md §9" >&2
        echo "" >&2
        exit 1
    fi
fi

# ── Rust 格式 ──
if command -v cargo >/dev/null 2>&1; then
    # 本仓根目录是 Tauri 混合仓，Rust 侧在 src-tauri/，须用 --manifest-path。
    if ! cargo fmt --manifest-path src-tauri/Cargo.toml -- --check >/dev/null 2>&1; then
        echo "" >&2
        echo "✗ cargo fmt 检查未通过，提交被拒绝。" >&2
        echo "" >&2
        echo "  修复：      cargo fmt --manifest-path src-tauri/Cargo.toml" >&2
        echo "  然后重新 git add 并提交。" >&2
        echo "" >&2
        exit 1
    fi
fi

exit 0
